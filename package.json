{
  "name": "deodap-sop-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Read-only Meta Ads SOP compliance and performance tracker for DeoDap",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "db:seed:dev": "npm run db:seed:dev --workspace server",
    "db:clear:dev": "npm run db:clear:dev --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace client",
    "start": "CLIENT_DIST_DIR=../client/dist npm run start --workspace server",
    "user:create": "npm run user:create --workspace server --",
    "report:export": "npm run report:export --workspace server --",
    "data": "npm run data --workspace server --"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
