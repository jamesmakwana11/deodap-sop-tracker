{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // The static demo (src/preview) reads a generated, git-ignored snapshot of development data.
  // It is not part of the production app and is type-checked by tsconfig.preview.json instead.
  "exclude": ["src/preview"]
}
