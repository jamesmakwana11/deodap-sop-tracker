{
  "name": "@sop/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "db:seed:dev": "tsx src/dev/seedDevData.ts",
    "db:clear:dev": "tsx src/dev/clearDevData.ts",
    "user:create": "tsx src/cli/createUser.ts",
    "report:export": "tsx src/cli/exportReport.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "preview:snapshot": "tsx src/cli/exportPreviewSnapshot.ts",
    "data": "tsx src/cli/data.ts"
  },
  "dependencies": {
    "@sop/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.15.2",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.0",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
