# ── DeoDap SOP Campaign Tracker ─────────────────────────────────────────────
# Local development: copy to server/.env   ·   Docker: copy to .env (project root)
# Never commit the filled-in file. Everything here stays on the server.

NODE_ENV=development
PORT=4000

# Data is stored as JSON files on the server. Default: server/data (created automatically).
# Back this folder up; it holds users, Meta connections, settings and every audit.
# On hosts that replace the app folder on redeploy, point this at a persistent disk or volume
# (see docs/SETUP.md section 12). Docker sets it to a mounted volume already.
# DATA_DIR=/var/lib/sop-tracker/data      (Render with a disk at /var/data: DATA_DIR=/var/data)
# Backups kept (one is made daily), saved export files kept, and exports built at once:
# BACKUP_KEEP=14
# REPORTS_KEEP=300
# EXPORT_CONCURRENCY=2

# First admin, created at start-up ONLY when no users exist yet (e.g. a new Render deploy).
# Stored as a password hash; ignored once any user exists, so it never overwrites or resets anyone.
# INITIAL_ADMIN_EMAIL=you@deodap.com
# INITIAL_ADMIN_PASSWORD=at-least-10-characters
# INITIAL_ADMIN_NAME=Your Name

# The address people open in the browser. Dev: http://localhost:5173  Prod: https://sop.yourdomain.com
CLIENT_ORIGIN=http://localhost:5173

# Behind nginx / a load balancer, set to 1 so client IPs, https detection and secure cookies work.
# On Render this is automatic (Render sets RENDER=true).
TRUST_PROXY=0
# Secure cookies are on automatically when NODE_ENV=production (requires HTTPS).
# COOKIE_SECURE=true
SESSION_TTL_HOURS=168

# 32-byte key that encrypts Meta tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe: if it is lost, stored Meta connections must be reconnected.
TOKEN_ENCRYPTION_KEY=

# Meta app (developers.facebook.com). Needed for "Connect Meta" (OAuth) and token checks.
# Admins can also enter these in the app (Meta & schedule → Meta app); saved values override these.
META_APP_ID=
META_APP_SECRET=
# Redirect URI: NOT needed. It is detected from the address the app is opened on
# (http://localhost:5173/..., https://<service>.onrender.com/..., https://<your-domain>/...) and shown
# with a Copy button in Meta & schedule → Meta app. Add each domain's URI once to the Meta app's
# "Valid OAuth Redirect URIs". Set this only to force one fixed URI:
# META_REDIRECT_URI=https://sop.yourdomain.com/api/meta/oauth/callback
META_GRAPH_VERSION=v26.0

# Daily refresh time in IST (HH:MM). Admins can change it in the app; empty = off.
SYNC_TIME_IST=07:30

# Production only: folder of the built web app (the Docker image sets this).
# CLIENT_DIST_DIR=../client/dist
